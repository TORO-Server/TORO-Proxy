# 本番ホストでのみ使う設定の例。
# この内容を PROJECT_DIR (toroserver スクリプトの配置先ルート) の ops.env に書くか、
# 環境変数として渡す。ops.env は .gitignore で除外され、リポジトリには入らない。

# Velocity の配置先 (plugins/ を含むディレクトリの絶対パス)
TORO_VELOCITY_DIR=/path/to/velocity

# ゲームサーバーのコンテナ名 (docker ps で出る名前)
MC_CONTAINER=your-game-container

# Velocity のコンテナ名 (ops/both-service で使う。docker-compose.yaml の container_name もこの値)
VELOCITY_CONTAINER=your-velocity-container
